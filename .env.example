# Host port. The container always listens on 8080.
VD_PORT=8080

# Public origin for Discord OAuth and share links. Example: https://app.viewdock.dev
# You can also set this later under Admin → Settings.
VD_PUBLIC_URL=

# NVIDIA NVENC. true or false. Requires the NVIDIA Container Toolkit on the host.
# The installer sets COMPOSE_PROFILES to match. If you edit VD_GPU by hand, set
# COMPOSE_PROFILES=gpu (true) or COMPOSE_PROFILES=cpu (false), then:
#   docker compose up -d --remove-orphans
VD_GPU=false
COMPOSE_PROFILES=cpu
